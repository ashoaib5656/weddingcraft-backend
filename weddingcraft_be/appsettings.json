{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Secret": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Gemini": {
    "ApiKey": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.PostgreSQL" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      },
      {
        "Name": "PostgreSQL",
        "Args": {
          "connectionString": "",
          "tableName": "logs",
          "needAutoCreateTable": false,
          "columnOptionsSection": {
            "addStandardColumns": [ "Message", "MessageTemplate", "Level", "TimeStamp", "Exception", "Properties" ],
            "additionalColumns": [
              {
                "ColumnName": "UserEmail",
                "PropertyName": "UserEmail",
                "DataType": "text"
              },
              {
                "ColumnName": "Endpoint",
                "PropertyName": "Endpoint",
                "DataType": "text"
              },
              {
                "ColumnName": "IpAddress",
                "PropertyName": "IpAddress",
                "DataType": "text"
              }
            ]
          }
        }
      }
    ]
  },
  "Redis": {
    "Host": "localhost",
    "Port": 6379,
    "Password": "",
    "Ssl": false,
    "AbortConnect": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "User": "",
    "Pass": "",
    "From": ""
  },
  "FrontendUrl": "http://localhost:5173",
  "Seed": {
    "AdminEmail": "admin@weddingcraft.local",
    "AdminPassword": ""
  },
  "AllowedHosts": "*"
}
